}#closeVideoGallery:hover {
    background: #ff2a6d;
    transform: scale(1.1);
}@media (max-width: 768px) {
    #closeVideoGallery {
        top: 12px;
        right: 12px;
        width: 44px;
        height: 44px;
        font-size: 26px;
    }
}

.ba-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 2500/1710;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.1);
    cursor: ew-resize;
    user-select: none;
}

.ba-img-container {
    position: relative;
    width: 100%;
    height: 100%;
}

.ba-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.ba-before {
    z-index: 1;
}

.ba-after {
    z-index: 2;
    clip-path: inset(0 0 0 50%); /* começa mostrando 50% */
}

.ba-divider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, #ff2a6d, #00ffcc);
    z-index: 3;
    transform: translateX(-50%);
    box-shadow: 0 0 10px rgba(255,42,109,0.6);
}

.ba-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background: #0a0a0a;
    border: 2px solid #ff2a6d;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ff2a6d;
    box-shadow: 0 0 10px rgba(255,42,109,0.6);
}

.ba-label {
    position: absolute;
    top: 12px;
    z-index: 4;
    background: rgba(5,5,5,0.75);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: white;
    pointer-events: none;
}

.ba-label-left { left: 12px; }
.ba-label-right { right: 12px; }

.site-bg-video {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    pointer-events: none;
}

.site-bg-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(2, 2, 2, 0.88); /* ajuste esse número (0 a 1) pra deixar mais claro ou mais escuro */
    z-index: -1;
    pointer-events: none;
}

.main-speedpaint-player {
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 0 0 1px rgba(255,42,109,0.15), 0 20px 50px rgba(0,0,0,0.5);
    transition: box-shadow 0.4s ease, transform 0.4s ease;
}

.main-speedpaint-player:hover {
    box-shadow: 0 0 25px rgba(255,42,109,0.35), 0 25px 60px rgba(0,0,0,0.6);
}

.main-speedpaint-player video {
    background: #000;
}

.main-speedpaint-player video::-webkit-media-controls-panel {
    background-image: linear-gradient(rgba(0,0,0,0), rgba(0,0,0,0.6));
}

/* Tag estilo Skilltree — faixa / washi tape */
.hero-tag {
    display: inline-block;
    margin: 0 0 14px;
    padding: 8px 18px;
    font-family: "Exo 2", sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1a1a1a;
    background: #13bf9a; /* rosa da faixa */
    border: none;
    border-radius: 2px;
    box-shadow: none;
    transform: rotate(-2deg); /* leve inclinação da fita */
    line-height: 1.2;
}

:root {
    --text-cream: #f3edd8;
}

body {
    color: var(--text-cream) !important;
}

/* Sobrescreve text-white / cinzas claros do Tailwind */
.text-white,
.text-gray-100,
.text-gray-200,
.text-gray-300 {
    color: var(--text-cream) !important;
}

/* Títulos e textos gerais */
h1, h2, h3, h4, h5, h6,
p, span, li, label, a {
    color: inherit;
}

/* Captions da galeria */
.gallery-caption p,
.gallery-caption .text-white,
.gallery-caption .text-gray-300 {
    color: var(--text-cream) !important;
}

/* Mantém os neons intactos */
.text-neonpink,
.text-neonblue,
.text-neonpurple,
.text-neonred,
.neon-text,
.neon-text-blue,
.neon-text-purple {
    /* não força creme aqui — deixa as cores neon */
}

.neon-text { color: #ff2a6d !important; }
.neon-text-blue { color: #00ffcc !important; }
.neon-text-purple { color: #d300c5 !important; }

.pain-strip {
    display: block;
    width: 100%;
    background: #0a0a0a;
    color: #f3edd8;
    padding: 14px 20px;
    border: 1px solid rgba(255, 42, 109, 0.25);
    box-shadow: 4px 4px 0 rgba(255, 42, 109, 0.35);
    clip-path: polygon(
        0 6%, 2% 0, 98% 2%, 100% 8%,
        99% 92%, 100% 100%, 2% 98%, 0 94%
    );
}

.pain-strip--offset {
    margin-left: 1.25rem;
    width: calc(100% - 1.25rem);
}

@media (max-width: 640px) {
    .pain-strip--offset {
        margin-left: 0;
        width: 100%;
    }
}

.pain-strip p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
}

.pain-x {
    text-decoration: line-through;
    text-decoration-color: #ff003c;
    text-decoration-thickness: 3px;
    color: rgba(243, 237, 216, 0.85);
}

/* ===== COMMISSION CARDS (versão final) ===== */
.commission-card {
    border-radius: 4px;
    overflow: hidden; /* cantos limpos; badge fica DENTRO */
    transition: all 0.3s ease;
    background: linear-gradient(145deg, rgba(10,10,10,0.8) 0%, rgba(5,5,5,0.9) 100%);
    border: 1px solid rgba(255,255,255,0.05);
    position: relative;
}

.commission-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 20px rgba(255,42,109,0.2);
    border-color: rgba(255,42,109,0.3);
}

.commission-card.featured {
    border: 1px solid rgba(255,42,109,0.5);
}

.commission-card-art {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #111;
}

.commission-card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
}

.commission-card:hover .commission-card-art img {
    transform: scale(1.06);
}

/* POPULAR — dentro da arte, sem cortar */
.popular-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 5;
    background: #ff2a6d;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 5px 12px;
    border-radius: 4px;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(255, 42, 109, 0.45);
}

/* desliga a faixa diagonal antiga */
.commission-card.featured::before {
    content: none !important;
    display: none !important;
}

/* ===== PROJETOS — igual Skilltree ===== */
.projects-section {
    padding: 80px 0;
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 10px;
    align-items: stretch;
}

@media (max-width: 768px) {
    .projects-grid {
        gap: 8px;
        padding: 0 8px;
    }
    .project-torn {
        padding: 28px 10px 16px;
        min-height: 0;
        gap: 9px;
    }
    .project-number { font-size: 1.6rem; }
    .project-title { font-size: 0.75rem; }
    .project-desc {
        font-size: 0.65rem;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .project-date { font-size: 0.55rem; }
    .project-date strong { font-size: 0.85rem; }
    .project-live { font-size: 0.5rem; padding: 2px 5px; }
    .project-footer { font-size: 0.55rem; padding-top: 8px; }
    .project-footer span { font-size: 0.7rem; }
    .project-tape {
        width: 56px;
        height: 16px;
        margin-left: -28px;
        top: -8px;
    }
    .project-media {
        margin: -4px -4px 4px;
        border-width: 1.5px;
    }
    .project-card {
        transform: none !important;
    }
}

.project-card {
    position: relative;
    transform: rotate(var(--r, 0deg));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    filter: drop-shadow(0 8px 0 rgba(0, 0, 0, 0.25));
}

.project-card:hover {
    transform: rotate(0deg) translateY(-8px);
}

/* Fita washi (largura da Skilltree) */
.project-tape {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 112px;
    height: 30px;
    margin-left: -56px;
    z-index: 5;
    pointer-events: none;
    clip-path: polygon(
        3% 8%, 22% 0, 48% 10%, 72% 2%, 97% 9%,
        100% 92%, 76% 100%, 50% 91%, 25% 100%, 0 90%
    );
    transform: rotate(-3deg);
}

.project-tape.pink   { background: rgba(247, 170, 224, 0.92); }
.project-tape.yellow { background: rgba(255, 217, 23, 0.92); transform: rotate(2.5deg); }
.project-tape.purple { background: rgba(201, 160, 255, 0.92); transform: rotate(-1.5deg); }

/* Papel rasgado — alto como o da Skilltree */
.project-torn {
    position: relative;
    background: #291f24;
    color: #f3edd8;
    padding: 38px 26px 30px;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    /* borda irregular top + bottom */
    clip-path: polygon(
        0% 8px, 4% 2px, 8% 10px, 12% 1px, 16% 9px, 20% 3px, 24% 11px, 28% 2px,
        32% 8px, 36% 1px, 40% 10px, 44% 3px, 48% 9px, 52% 2px, 56% 11px, 60% 1px,
        64% 8px, 68% 3px, 72% 10px, 76% 2px, 80% 9px, 84% 1px, 88% 11px, 92% 3px,
        96% 8px, 100% 2px,
        100% calc(100% - 10px), 96% calc(100% - 2px), 92% calc(100% - 11px),
        88% calc(100% - 3px), 84% calc(100% - 9px), 80% calc(100% - 1px),
        76% calc(100% - 10px), 72% calc(100% - 2px), 68% calc(100% - 8px),
        64% calc(100% - 1px), 60% calc(100% - 11px), 56% calc(100% - 3px),
        52% calc(100% - 9px), 48% calc(100% - 2px), 44% calc(100% - 10px),
        40% calc(100% - 1px), 36% calc(100% - 8px), 32% calc(100% - 3px),
        28% calc(100% - 11px), 24% calc(100% - 2px), 20% calc(100% - 9px),
        16% calc(100% - 1px), 12% calc(100% - 10px), 8% calc(100% - 3px),
        4% calc(100% - 8px), 0% calc(100% - 2px)
    );
}

/* Imagem com borda preta, como .media da Skilltree */
.project-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 2px solid #111;
    background: #111;
    margin: -8px -8px 6px;
}

.project-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.project-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
}

.project-number {
    font-size: clamp(48px, 4.5vw, 64px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #111;
}

.project-date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #333;
    gap: 2px;
    padding-top: 8px;
}

.project-date strong {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 0.04em;
}

.project-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: #ff4f2e;
    color: #fff;
    padding: 4px 8px;
}

.project-live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
}

.project-title {
    font-size: clamp(24px, 2.2vw, 30px);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
    color: #111;
}

.project-desc {
    font-size: 15px;
    line-height: 1.5;
    color: #222;
    margin: 0;
    flex-grow: 1;
}

.project-footer {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1.5px dashed #111;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #444;
}

.project-footer span {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: none;
    color: #111;
}

@media (max-width: 899px) {
    .project-card {
        max-width: 420px;
        margin-inline: auto;
        transform: none !important;
    }
    .project-torn {
        min-height: 0;
    }
}

/* seções totalmente transparentes */
#gallery,
#speedpaint,
#commissions,
#process,
#about,
section#gallery,
section#speedpaint,
section#commissions {
    background: transparent !important;
    background-color: transparent !important;
    background-image: none !important;
}

#gallery > div,
#speedpaint > div,
#commissions > div,
#gallery .container,
#speedpaint .container,
#commissions .container {
    background: transparent !important;
    background-color: transparent !important;
}

/* ===== SEÇÕES ESTILO PAPEL ===== */
.paper-sec{
  background:transparent;
  color:#f3edd8;
  font-family:"Familjen Grotesk",sans-serif;
  padding:clamp(64px,8vw,112px) 0;
  position:relative;
}
.paper-sec *{box-sizing:border-box}
.paper-wrap{max-width:1240px;margin:0 auto;padding:0 clamp(16px,4vw,56px)}
.paper-title{
  font-family:"Anton",Impact,sans-serif;font-weight:400;text-transform:uppercase;
  line-height:.95;font-size:clamp(36px,4.6vw,66px);color:#f3edd8;margin:0;text-wrap:balance;
}

/* --- grid de 5 cards --- */
.who-head{text-align:center;margin-bottom:clamp(36px,5vw,72px)}
.who-grid{
  display:grid;grid-template-columns:repeat(6,minmax(0,1fr));
  gap:clamp(20px,2.4vw,32px);list-style:none;margin:0 auto;padding:0 clamp(16px,4vw,56px);max-width:1240px;
}
.who-card{grid-column:span 2;display:flex;flex-direction:column;gap:10px;min-width:0}
.who-card:nth-child(4){grid-column:2 / span 2}
.who-card:nth-child(5){grid-column:4 / span 2}
.who-img{position:relative;display:block;aspect-ratio:16/10;overflow:hidden;border:2px solid #f3edd8;background:#000}
.who-img img{width:100%;height:100%;object-fit:cover;display:block}
.img-tag{
  position:absolute;left:8px;top:8px;z-index:2;background:#000;color:#f3edd8;
  font-size:13px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;
  padding:5px 9px;line-height:1.1;
}
.who-n{font-family:"Anton",Impact,sans-serif;font-size:28px;line-height:1;margin-top:6px}
.who-card p{font-size:18px;font-weight:600;line-height:1.3;max-width:30ch;margin:0}
@media (max-width:860px){
  .who-grid{grid-template-columns:1fr 1fr}
  .who-card,.who-card:nth-child(4),.who-card:nth-child(5){grid-column:auto}
}
@media (max-width:520px){.who-grid{grid-template-columns:1fr}}

/* --- papel rasgado + fita --- */
.torn-wrap{position:relative;filter:drop-shadow(0 6px 0 rgba(0,0,0,.35))}
.paper-sec .tape{
  position:absolute;width:112px;height:30px;z-index:3;pointer-events:none;
  clip-path:polygon(3% 8%,22% 0,48% 10%,72% 2%,97% 9%,100% 92%,76% 100%,50% 91%,25% 100%,0 90%);
}
.tape--y{background:rgba(255,217,23,.9)}
.tape--p{background:rgba(247,170,224,.9)}

/* --- bloco "quem está por trás" --- */
.about-grid{
  display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);
  gap:clamp(36px,6vw,96px);align-items:center;
}
.about-paper{transform:rotate(.8deg)}
.about-paper .torn{
  background:#EEE7C4;color:#000;padding:clamp(26px,3vw,40px);
  font-size:clamp(17px,1.4vw,20px);line-height:1.55;font-weight:500;
}
.about-paper .torn p{margin:0}
.about-paper .torn p + p{margin-top:1em}
.about-paper .tape{top:-14px;left:12%;transform:rotate(-6deg)}
.grifo{
  background:linear-gradient(#FFD917,#FFD917) no-repeat 0 78% / 100% 62%;
  font-weight:700;
}
.about-strip{grid-column:1 / -1;transform:rotate(-.6deg);margin:clamp(12px,2vw,24px) 0 0}
.about-strip .torn{background:#FDFCF6;padding:14px}
.about-strip img{display:block;width:100%;height:auto}
.about-strip .tape{top:-12px;right:14%;transform:rotate(4deg)}
.about-strip figcaption{
  display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px 16px;margin-top:12px;
  font-size:14.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#000;
}
@media (max-width:860px){.about-grid{grid-template-columns:1fr}}

/* texto creme nos cards de Projects */
.project-number,
.project-title,
.project-desc,
.project-date,
.project-date strong,
.project-footer,
.project-footer span,
.project-live {
    color: #f3edd8 !important;
}

/* ===== LIGHTBOX PROCESS - VERSÃO MELHORADA ===== */
.lb-process {
  display: none;
  max-width: 920px;
  margin: 0 auto;
  padding: 40px 16px 100px;
}

.lb-process-title {
  font-size: clamp(22px, 3.5vw, 32px);
  font-weight: 800;
  text-transform: uppercase;
  text-align: center;
  margin: 0 0 36px;
  color: #f3edd8;
  letter-spacing: 0.04em;
}

.lb-step {
  margin: 0 0 36px;
  background: #141014;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
}

.lb-step figcaption {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin: 16px 16px 12px;
  padding: 6px 14px;
  border-radius: 999px;
  background: linear-gradient(135deg, #ff2a6d, #ff4d85);
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  box-shadow: 0 4px 14px rgba(255, 42, 109, 0.35);
}

.lb-step img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 0;
  border: none;
}

/* Botão "View process" mais bonito */
.lb-hint {
  position: absolute;
  left: 50%;
  bottom: 28px;
  transform: translateX(-50%);
  z-index: 5;
  display: none;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.75);
  border: 1.5px solid #ff2a6d;
  color: #f3edd8;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  cursor: pointer;
  backdrop-filter: blur(8px);
  transition: all 0.25s ease;
  animation: lbBounce 1.8s ease-in-out infinite;
}

.lb-hint:hover {
  background: #ff2a6d;
  color: white;
  box-shadow: 0 0 20px rgba(255, 42, 109, 0.5);
}

/* Select dark theme fix */
#subject,
select {
    background-color: #0a0a0a !important;
    color: #f3edd8 !important;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

#subject:focus,
select:focus {
    border-color: #ff2a6d;
    box-shadow: 0 0 0 2px rgba(255, 42, 109, 0.35);
    outline: none;
}

/* Options (works in most browsers) */
select option {
    background-color: #0a0a0a !important;
    color: #f3edd8 !important;
}

select option:checked,
