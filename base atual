function parseProcess(item) {
    const raw = item && item.dataset.process;
    if (!raw) return [];
    return raw.split(';;').map(s => s.trim()).filter(Boolean).map(s => {
        const i = s.indexOf('|');
        return i > -1
            ? { label: s.slice(0, i).trim(), src: s.slice(i + 1).trim() }
            : { label: '', src: s };
    });
}

