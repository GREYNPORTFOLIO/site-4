(function() {
  const topBtn = document.getElementById('scrollTopBtn');
  const bottomBtn = document.getElementById('scrollBottomBtn');

  if (!topBtn || !bottomBtn) return;

  function toggleButtons() {
    const scrollTop = window.scrollY || document.documentElement.scrollTop;
    const windowHeight = window.innerHeight;
    const docHeight = document.documentElement.scrollHeight;

    // Mostra o botão de subir quando descer um pouco
    if (scrollTop > 400) {
      topBtn.classList.add('show');
    } else {
      topBtn.classList.remove('show');
    }

    // Mostra o botão de descer quando ainda não estiver perto do final
    if (scrollTop + windowHeight < docHeight - 300) {
      bottomBtn.classList.add('show');
    } else {
      bottomBtn.classList.remove('show');
    }
  }

  window.addEventListener('scroll', toggleButtons, { passive: true });
  window.addEventListener('resize', toggleButtons);
  toggleButtons(); // roda uma vez no carregamento

  // Ação dos botões
  topBtn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  bottomBtn.addEventListener('click', () => {
    window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
  });
})();
