    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
}/* Modal de vídeos melhorado */
#videoGalleryModal {
    z-index: 99999 !important;
}#videoGalleryModal .modal-inner {
    position: relative;
    width: 100%;
    max-width: 72rem;
    max-height: 90vh;
    overflow-y: auto;
    padding-top: 3.5rem;
}/* Botão fechar fixo e fácil de clicar no mobile */
#closeVideoGallery {
    position: fixed;
    top: 16px;
    right: 16px;
    width: 48px;
    height: 48px;
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 42, 109, 0.5);
    border-radius: 50%;
    color: white;
    font-size: 28px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100000;
    cursor: pointer;
